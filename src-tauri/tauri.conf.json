{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quran",
  "version": "0.1.0",
  "identifier": "com.productivity-os.quran",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["productivity-quran"] } }
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Quran",
      "width": 920,
      "height": 720,
      "minWidth": 620,
      "minHeight": 480,
      "resizable": true,
      "decorations": true,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "visible": false,
      "trafficLightPosition": { "x": 14, "y": 17 }
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "infoPlist": "Info.plist" }
  }
}
